# Credentials. `.env` alone matches only that exact name, so a backup or
# variant (.env.bak, .env.local, an editor save) was untracked-but-committable
# — observed live 2026-08-19 with a .env.bak-* holding FANTRAX_PASSWORD.
.env
.env.*
!.env.example
rosterbot
*.test
.claude/settings.local.json
.cache/
.fantrax-cache/
.backtest/
.analysis/
.teamvalue/
.footballvalue/
.football/
.lineupgap/
.trades/
.tradevalues/
.tradeoffers/
.reports/
# Anchored: the dashboard publish dir is ./report at the repo root. Unanchored,
# this also matched internal/report/, silently ignoring every NEW file added to
# that package (already-tracked files were unaffected, which is why it went
# unnoticed).
/report/
.waivers/
.lineup/
.superpowers/
fangraphs-leaderboard-projections*.csv
verify_periods
ideas
.playwright-mcp/

# CDK build artifacts
infra/infra
infra/cdk.out/
infra/cdk.context.json.bak

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# Beads passive exports — real sync is via refs/dolt/data on the git remote,
# not these files; tracking them just churns every commit (see CLAUDE.md).
.beads/issues.jsonl
.beads/interactions.jsonl
